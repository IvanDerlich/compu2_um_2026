#!/usr/bin/env python3
"""
Convierte temperaturas entre Celsius y Fahrenheit.
"""

import argparse
import sys

def crear_parser():
    """Configura el parser de argumentos."""    
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("temperatura", type=float, help="Temperatura a convertir")
    parser.add_argument(
      "-t",
      "--to",
      type=str.upper,
      choices=["C", "F", "c", "f", "Celsius", "Fahrenheit"],
      required=True,
      help="Unidad de destino: C o F",
    )
    return parser

def convertir(temperatura, unidad_destino):
    """Convierte la temperatura a la unidad de destino."""
    if unidad_destino in ["C", "c", "Celsius"]:
        temp = (temperatura - 32) * 5 / 9
        print(f"Temperatura convertida a Celsius: {temp}")        
    elif unidad_destino in ["F", "f", "Fahrenheit"]:
        temp = temperatura * 9 / 5 + 32
        print(f"Temperatura convertida a Fahrenheit: {temp}")        
    else:
        raise ValueError("Unidad de destino no válida")

def main():
    parser = crear_parser()
    args = parser.parse_args()

    try:
        convertir(args.temperatura, args.to)
        return 0
    except KeyboardInterrupt:
        print("\nInterrumpido", file=sys.stderr)
        sys.exit(130)
    except ValueError as error:
        print(f"Error: {error}", file=sys.stderr)
        return 1

if __name__ == "__main__":
    sys.exit(main())