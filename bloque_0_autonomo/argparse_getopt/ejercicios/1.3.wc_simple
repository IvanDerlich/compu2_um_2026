#!/usr/bin/env python3

import sys

if len(sys.argv) != 2:
  print(f"Error: se requiere un archivo como argumento", file=sys.stderr)
  sys.exit(1)

try:
  with open(sys.argv[1], "r", encoding="utf-8") as archivo:
    lineas = archivo.readlines()
except FileNotFoundError:
  print(f"Error: el archivo '{sys.argv[1]}' no existe.", file=sys.stderr)
  sys.exit(1)

palabras = sum(len(linea.split()) for linea in lineas)
caracteres = sum(len(linea) for linea in lineas)

print(f"Líneas: {len(lineas)}")
print(f"Palabras: {palabras}")
print(f"Caracteres: {caracteres}")